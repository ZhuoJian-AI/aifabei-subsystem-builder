ZHUOJIAN_INTEGRATION_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-another-at-least-32-random-characters
ZHUOJIAN_ORGANIZATION_ID=replace-with-platform-organization-uuid
ZHUOJIAN_SAAS_ORIGINS=https://ai-platform.staging.zhuojianai.com
DATABASE_PATH=/data/subsystem.db
FILE_STORAGE_DRIVER=local
# 本地模式固定写入数据卷；切换 OSS 时管理员 Runtime 会自动改为 oss-gateway 并注入下列两项。
FILE_STORAGE_GATEWAY_URL=
FILE_STORAGE_TOKEN=
FILE_STORAGE_GATEWAY_TIMEOUT_SECONDS=30
FILE_STORAGE_MAX_UPLOAD_BYTES=536870912
FILE_STORAGE_SPOOL_DIR=/data/files/.tmp
# Production Runtime injects its read-only disk gate here. Leave blank only for local development.
FILE_STORAGE_STATE_FILE=
ZHUOJIAN_IMAGE_NAME=zhuojian/aifabei/example:local
ZHUOJIAN_DATA_DIR=/srv/zhuojian/data/example
ZHUOJIAN_APP_PORT=18000
